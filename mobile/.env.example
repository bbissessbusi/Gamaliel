# Gamaliel Mobile — Environment Variables
# Copy this file to .env and fill in your actual values, then restart
# `npx expo start -c` (the -c clears the Metro cache so new env vars pick up).
#
# Expo inlines any EXPO_PUBLIC_* variable into the JS bundle at build time —
# these are NOT secret and ship inside the app. Never put private API keys
# (Anthropic, Deepgram) here; those live server-side in the backend deployment
# that serves /api/transcribe, /api/analyze, /api/health (see api/ in the repo
# root — the same Vercel Edge Functions the web app uses).

# Supabase — same project as the web app (auth + evaluations table + storage)
# Dashboard: https://supabase.com/dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend API base URL — the deployed Gamaliel web app's origin, since a
# mobile app has no "same origin" to call relative /api/ routes against.
#
# Two candidate deployments were mentioned during setup — confirm which one
# is the actual production/stable URL and correct this if needed:
#   https://gamaliel-git-claude-fix-scor-caf2cf-brittneys-projects-3d4bf32b.vercel.app  (used below, branch preview — auto-updates on push to that branch)
#   https://gamaliel-hvwpnx9d9-brittneys-projects-3d4bf32b.vercel.app                    (a specific, non-updating deployment)
EXPO_PUBLIC_API_BASE_URL=https://gamaliel-git-claude-fix-scor-caf2cf-brittneys-projects-3d4bf32b.vercel.app
